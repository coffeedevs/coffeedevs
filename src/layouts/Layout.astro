---
import '@styles/global.css';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = 'CoffeeDevs es una agencia de desarrollo de software' } = Astro.props;
const currentLocale = Astro.url.pathname.startsWith('/en') ? 'en' : 'es';
---

<!DOCTYPE html>
<html lang={currentLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | CoffeeDevs</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600;700&display=swap" rel="stylesheet" />
    
    <!-- Bootstrap for grid -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/3.3.7/css/bootstrap.min.css" rel="stylesheet" />
    
    <!-- WOW animations -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/wow/1.3.2/wow.min.js"></script>
    
    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" />
  </head>
  
  <body class="font-sans text-gray-900">
    <!-- Header/Navigation -->
    <header class="navbar navbar-default navbar-fixed-top">
      <div class="container">
        <div class="navbar-header">
          <a href="/" class="navbar-brand">
            <img src="/images/logo.png" alt="CoffeeDevs" style="height: 30px" />
          </a>
        </div>
        
        <div class="navbar-collapse collapse">
          <ul class="nav navbar-nav navbar-right">
            <li><a href="/services">{currentLocale === 'en' ? 'Services' : 'Servicios'}</a></li>
            <li><a href="/#blog">{currentLocale === 'en' ? 'Blog' : 'Blog'}</a></li>
            <li><a href="/#contact">{currentLocale === 'en' ? 'Contact' : 'Contacto'}</a></li>
            <li class="dropdown">
              <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                {currentLocale === 'en' ? 'English' : 'Español'} <span class="caret"></span>
              </a>
              <ul class="dropdown-menu">
                <li><a href="/">Español</a></li>
                <li><a href="/en">English</a></li>
              </ul>
            </li>
          </ul>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="footer">
      <div class="container">
        <p class="text-muted text-center">
          &copy; 2024 CoffeeDevs. {currentLocale === 'en' ? 'All rights reserved.' : 'Todos los derechos reservados.'}
        </p>
      </div>
    </footer>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-2.2.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/3.3.7/js/bootstrap.min.js"></script>
    <script>
      new WOW().init();
      
      // Smooth scroll
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
          e.preventDefault();
          const target = document.querySelector(this.getAttribute('href'));
          if (target) {
            target.scrollIntoView({ behavior: 'smooth' });
          }
        });
      });
    </script>
  </body>
</html>
