---
import '@styles/global.css';
import { siteCopy, type SiteLocale } from '@utils/siteCopy';

export interface Props {
  locale: SiteLocale;
  title?: string;
  description?: string;
}

const { locale, title, description } = Astro.props;
const copy = siteCopy[locale];
const pageTitle = title ?? `CoffeeDevs - ${copy.hero.subtitle}`;
const pageDescription = description ?? copy.metaDescription;
const canonicalPath = locale === 'es' ? '/' : '/en/';
const canonicalUrl = `https://coffeedevs.com${canonicalPath}`;
const featuresUrl = `${canonicalPath}#features`;
const contactUrl = `${canonicalPath}#contact`;
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={copy.hero.subtitle} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://coffeedevs.com/images/portada2.jpg" />
    <meta property="og:description" content={pageDescription} />
    <link rel="icon" href="/favicon.ico" />
  </head>
  
  <body>
    <!-- Header/Navigation -->
    <header>
      <nav>
        <a href={canonicalPath} class="brand-link" aria-label="CoffeeDevs home">
          <img src="/images/logo.png" alt="Logo Coffeedevs" class="coffee-logo" />
          <span class="brand-name">CoffeeDevs</span>
        </a>
        
        <div style="display: flex; align-items: center; gap: 2rem;">
          <a href={canonicalPath}>{copy.nav.home}</a>
          <a href={featuresUrl}>{copy.nav.features}</a>
          <a href={contactUrl}>{copy.nav.contact}</a>
          <a href="https://blog.coffeedevs.com/" rel="noopener noreferrer">{copy.nav.blog}</a>
          <a href={copy.nav.localeSwitchHref}>{copy.nav.localeSwitch}</a>
        </div>
      </nav>
    </header>

    <!-- Main Content -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer>
      <p>
        <a href="https://coffeedevs.com/" style="color: inherit; text-decoration: none;">
          CoffeeDevs - {copy.footer}
        </a>
      </p>
    </footer>

    <script>
      // Smooth scroll
      document.querySelectorAll('a[href*="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
          const href = this.getAttribute('href');
          if (!href || href.startsWith('http')) return;

          const url = new URL(href, window.location.origin);
          if (url.pathname !== window.location.pathname || !url.hash) return;

          const target = document.querySelector(url.hash);
          if (!target) return;

          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth' });
        });
      });
    </script>
  </body>
</html>
