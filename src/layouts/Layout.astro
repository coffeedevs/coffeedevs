---
import '@styles/global.css';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = 'CoffeeDevs - Desarrollo profesional de software' } = Astro.props;
const currentLocale = Astro.url.pathname.startsWith('/en') ? 'en' : 'es';
---

<!DOCTYPE html>
<html lang={currentLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | CoffeeDevs</title>
    <link rel="icon" href="/favicon.ico" />
  </head>
  
  <body>
    <!-- Header/Navigation -->
    <header>
      <nav>
        <a href="/" style="display: flex; align-items: center; gap: 0.5rem;">
          <img src="/images/logo.png" alt="CoffeeDevs" />
        </a>
        
        <div style="display: flex; align-items: center; gap: 2rem;">
          <a href="/services">{currentLocale === 'en' ? 'Services' : 'Servicios'}</a>
          <a href="/#blog">{currentLocale === 'en' ? 'Blog' : 'Blog'}</a>
          <a href="/#contact">{currentLocale === 'en' ? 'Contact' : 'Contacto'}</a>
          
          <!-- Language Selector -->
          <select 
            style="
              border: 1px solid #e5e5e5;
              background: white;
              padding: 0.5rem;
              border-radius: 4px;
              font-family: inherit;
              cursor: pointer;
              font-size: 0.95rem;
              color: #333;
            "
            onchange={`window.location.href = this.value`}
            value={currentLocale === 'en' ? '/en' : '/'}
          >
            <option value="/">Español</option>
            <option value="/en">English</option>
          </select>
        </div>
      </nav>
    </header>

    <!-- Main Content -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer>
      <p>
        &copy; 2024 CoffeeDevs. {currentLocale === 'en' ? 'All rights reserved.' : 'Todos los derechos reservados.'}
      </p>
    </footer>

    <script>
      // Smooth scroll
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
          e.preventDefault();
          const target = document.querySelector(this.getAttribute('href'));
          if (target) {
            target.scrollIntoView({ behavior: 'smooth' });
          }
        });
      });
    </script>
  </body>
</html>
