---
import Layout from '@layouts/Layout.astro';

const locale = 'en';
const services = [
  {
    title: 'Web Development',
    description: 'We create modern, fast, and scalable websites using the best technologies available.'
  },
  {
    title: 'Mobile Applications',
    description: 'We develop native and hybrid applications for iOS and Android.'
  },
  {
    title: 'UI/UX Design',
    description: 'We design beautiful and functional interfaces that improve user experience.'
  },
  {
    title: 'Technical Consulting',
    description: 'We advise companies on software architecture and best practices.'
  }
];
---

<Layout title="Services">
  <main class="max-w-7xl mx-auto px-4 py-20">
    <h1 class="text-4xl font-bold mb-12">Our Services</h1>
    
    <div class="grid md:grid-cols-2 gap-12">
      {services.map(service => (
        <div class="border-l-4 border-blue-600 pl-6">
          <h2 class="text-2xl font-bold mb-4">{service.title}</h2>
          <p class="text-gray-600">{service.description}</p>
        </div>
      ))}
    </div>
  </main>
</Layout>
