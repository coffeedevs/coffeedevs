---
import Layout from '@layouts/Layout.astro';

const locale = 'es';
const services = [
  {
    title: 'Desarrollo Web',
    description: 'Creamos sitios web modernos, rápidos y escalables usando las mejores tecnologías del mercado.'
  },
  {
    title: 'Aplicaciones Móviles',
    description: 'Desarrollamos aplicaciones nativas e híbridas para iOS y Android.'
  },
  {
    title: 'Diseño UI/UX',
    description: 'Diseñamos interfaces hermosas y funcionales que mejoran la experiencia del usuario.'
  },
  {
    title: 'Consultoría Técnica',
    description: 'Asesoramos a empresas en arquitectura de software y mejores prácticas.'
  }
];
---

<Layout locale={locale} title="Servicios | CoffeeDevs">
  <main class="max-w-7xl mx-auto px-4 py-20">
    <h1 class="text-4xl font-bold mb-12">Nuestros Servicios</h1>
    
    <div class="grid md:grid-cols-2 gap-12">
      {services.map(service => (
        <div class="border-l-4 border-blue-600 pl-6">
          <h2 class="text-2xl font-bold mb-4">{service.title}</h2>
          <p class="text-gray-600">{service.description}</p>
        </div>
      ))}
    </div>
  </main>
</Layout>
