---
import Layout from '@layouts/Layout.astro';

const locale = 'es';
const services = [
  {
    title: 'Desarrollo Web',
    description: 'Creamos sitios web modernos, r\u00E1pidos y escalables usando las mejores tecnolog\u00EDas del mercado.'
  },
  {
    title: 'Aplicaciones M\u00F3viles',
    description: 'Desarrollamos aplicaciones nativas e h\u00EDbridas para iOS y Android.'
  },
  {
    title: 'Dise\u00F1o UI/UX',
    description: 'Dise\u00F1amos interfaces hermosas y funcionales que mejoran la experiencia del usuario.'
  },
  {
    title: 'Consultor\u00EDa e IA',
    description: 'Asesoramos en procesos de desarrollo, integraci\u00F3n de inteligencia artificial, adopci\u00F3n de nuevas tecnolog\u00EDas y optimizaci\u00F3n de equipos con herramientas de IA.'
  }
];
---

<Layout locale={locale} title="Servicios | CoffeeDevs">
  <div class="pt-24 pb-24 px-6">
    <div class="mx-auto max-w-6xl">
      <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Nuestros Servicios</h1>
      <p class="mt-4 text-lg text-gray-500">Todo lo que necesit\u00E1s para llevar tu producto digital al siguiente nivel.</p>

      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {services.map(service => (
          <div class="rounded-2xl border border-gray-200 bg-white p-8 transition-all hover:border-gray-300 hover:shadow-md">
            <h2 class="text-lg font-semibold text-gray-900">{service.title}</h2>
            <p class="mt-3 text-sm leading-relaxed text-gray-500">{service.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>
